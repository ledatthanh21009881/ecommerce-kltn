# ========== Backend PHP API ==========
# Ghi đè URL (ưu tiên cao nhất — dùng cho mọi route proxy):
# BACKEND_URL=http://localhost:8000
#
# Tự chọn khi KHÔNG set BACKEND_URL:
# - npm run dev (NODE_ENV=development) → http://localhost:8000
# - production build → http://103.90.225.212:8000
# NEXT_PUBLIC_BACKEND_URL_LOCAL=http://localhost:8000
# NEXT_PUBLIC_BACKEND_URL_VPS=http://103.90.225.212:8000

# ========== WebSocket (messenger) ==========
# NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8080
# NEXT_PUBLIC_WEBSOCKET_URL_LOCAL=ws://localhost:8080
# NEXT_PUBLIC_WEBSOCKET_PORT=8080

# ========== Mapbox ==========
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here