# Mapbox (required for admin tracking map and shipper detail map)
# Get your token at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# WebSocket (messenger real-time)
# Preferred: set full URL, e.g. ws://103.90.225.212:8080 or wss://your-domain/ws
NEXT_PUBLIC_WEBSOCKET_URL=
# Optional when NEXT_PUBLIC_WEBSOCKET_URL is empty; client will derive host from current origin.
NEXT_PUBLIC_WEBSOCKET_PORT=8080
